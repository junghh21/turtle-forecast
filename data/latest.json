-9) * Math.sqrt(5));\n    o.close = 0.5 + 0.06 * Math.tanh(z);\n  }\n  out[k] = o;\n}\nreturn out;","author":"seed","created_at":"2026-10-28T13:30:22.498Z","status":"active","last":{"spx":{"h1":0.4793,"close":0.5058},"ndx":{"h1":0.4621,"close":0.5057},"tlt":{"h1":0.5457,"close":0.5503},"boil":{"h1":0.5783,"close":0.449},"kospi":{"h1":0.5076,"close":0.5314}}},{"id":"daily_reversal","description":"close: fade yesterday's move when it was large versus the 60-day volatility (z-score of the last daily return).","code":"\nconst out = {};\nfor (const [k, a] of Object.entries(data.assets)) {\n  const d = a.daily.map((x) => x[1]);\n  if (d.length < 62) continue;\n  const r = lib.returns(d.slice(-61));\n  const z = r.at(-1) / (lib.std(r.slice(0, -1)) || 1e-9);\n  out[k] = { close: 0.5 - 0.07 * Math.tanh(z / 1.5) };\n}\nreturn out;","author":"seed","created_at":"2026-10-28T13:30:22.498Z","status":"active","last":{"spx":{"close":0.4612},"ndx":{"close":0.4539},"tlt":{"close":0.5041},"boil":{"close":0.5233},"kospi":{"close":0.4411}}},{"id":"trend_20d","description":"close: price above/below its 20-day average, strength by distance in volatility units.","code":"\nconst out = {};\nfor (const [k, a] of Object.entries(data.assets)) {\n  const d = a.daily.map((x) => x[1]);\n  if (d.length < 40) continue;\n  const dist = (d.at(-1) - lib.mean(d.slice(-20))) / (lib.std(d.slice(-20)) || 1e-9);\n  out[k] = { close: 0.5 + 0.05 * Math.tanh(dist / 2) };\n}\nreturn out;","author":"seed","created_at":"2026-10-28T13:30:22.498Z","status":"active","last":{"spx":{"close":0.4971},"ndx":{"close":0.4845},"tlt":{"close":0.5324},"boil":{"close":0.4676},"kospi":{"close":0.4942}}},{"id":"event_adjusted_momentum","description":"Adjusts momentum probabilities based on the direction of the last daily close to capture persistent short-term trends.","code":"const res = {}; for (const k of ['spx','ndx','tlt','boil','kospi']) { const d = data.assets[k].daily; const last = d[d.length-1][1], prev = d[d.length-2][1